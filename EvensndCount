package com.nit.array;

public class EvensndCount {

	public static void main(String[] args){
		// TODO Auto-generated method stub
        int[] arr= {3,7,8,4,9,1,2,9};
        int sum=0;
        int count=0;
        for(int x:arr) {
        	if( x%2==0) {
        		sum+=x;
        		count++;
        	}
        	
        }
        System.out.println("even " +sum+":count="+count);
	}

}
