package src.com.nit.array;

public class FIndMissingNumber {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
       int []arr= {1,2,3,5};
       
        for(int i=1;i<=5;i++) {
        	boolean found =false;
        	
        	for(int j=0;j<arr.length;j++) {
        		
        		if(arr[j]==i) {
        			found=true;
        			
        			break;
        		}
        	}
        	if(!found) {
        		System.out.println("Missing="+i);
        		break;
        	}
        }
	}

}
