package com.dailypdf;

public class RightPattern {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
      int num=8;
      
      for(int i = 1;i<= num; i++) {
    	  
    	  for(int j = 1;j <= num-i; j++) {
    		  System.out.print(" ");
    	  }
    	  for(int j= 1; j<= i; j++) {
    		  System.out.print("* ");
    	  }
    	  System.out.println( );
      }
	}

}
